# === Application ===
APP_ENVIRONMENT=local
APP_LOG_LEVEL=INFO
APP_STORAGE_BACKEND=sqlite
APP_DATABASE_URL=sqlite+aiosqlite:///./data/security_platform.db
APP_REDIS_URL=redis://localhost:6379/0
APP_WORKSPACE_DIR=./data/workspaces
APP_REPORTS_DIR=./data/reports

# === Model providers (leave blank to use mock mode) ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-05-01-preview
OLLAMA_BASE_URL=http://localhost:11434

# Set to "true" to force all model calls to use the deterministic mock client.
# This is the default in local dev with no API keys present.
MODEL_MOCK_MODE=true

# Host directory mounted read-only at /scan-targets inside the container
SCAN_TARGETS_DIR=./scan-targets

# === Observability ===
OTEL_SERVICE_NAME=security-agent-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_ENABLED=true
OTEL_METRICS_ENABLED=true
OTEL_LOGS_ENABLED=true

# === MCP placeholders (unused until real MCP servers are wired up) ===
MCP_GITHUB_SERVER_URL=
MCP_AZURE_DEVOPS_SERVER_URL=
MCP_JIRA_SERVER_URL=
MCP_SONARQUBE_SERVER_URL=
MCP_VULN_DB_SERVER_URL=
MCP_VAULT_SERVER_URL=
