{
  "title": "Governed AI Code Security - PoC Overview",
  "uid": "sap-mvp-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Total Analyses",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(analysis_jobs_total)", "legendFormat": "analyses" }
      ]
    },
    {
      "id": 2,
      "title": "Error Rate (%)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "100 * sum(analysis_jobs_failed_total) / clamp_min(sum(analysis_jobs_total), 1)",
          "legendFormat": "error rate"
        }
      ]
    },
    {
      "id": 3,
      "title": "Average Analysis Duration (s)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(analysis_duration_seconds_sum[15m]) / clamp_min(rate(analysis_duration_seconds_count[15m]), 1e-9)",
          "legendFormat": "avg duration"
        }
      ]
    },
    {
      "id": 4,
      "title": "Total LLM Calls",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "sum(llm_calls_total)", "legendFormat": "llm calls" }
      ]
    },
    {
      "id": 5,
      "title": "Findings by Severity",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum by (severity) (findings_by_severity_total)",
          "legendFormat": "{{severity}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Tool Executions by Tool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "sum by (tool_name) (rate(tool_execution_duration_seconds_count[15m]))",
          "legendFormat": "{{tool_name}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "LLM Token Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "sum by (token_type) (rate(llm_tokens_total[15m]))",
          "legendFormat": "{{token_type}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "LLM Estimated Cost (USD/hr)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "sum(rate(llm_cost_estimate_total[1h])) * 3600",
          "legendFormat": "cost/hr"
        }
      ]
    },
    {
      "id": 9,
      "title": "Agent Node Duration (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, node_name) (rate(agent_node_duration_seconds_bucket[15m])))",
          "legendFormat": "{{node_name}}"
        }
      ]
    }
  ]
}
